                        gameVideoPlayer.pause()
                    else
                        gameVideoPlayer.play()
                }
            }
            Slider {
                id: fullscreenPosition
                Layout.fillWidth: true
                from: 0
                to: Math.max(1, gameVideoPlayer.duration)
                onMoved: {
