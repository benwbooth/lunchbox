                                        onClicked: {
                                            root.pendingRecoveryJobId = downloadQueue.job_id_at(
                                                        downloadRow.index)
                                            root.pendingRecoveryJobTitle = downloadQueue.job_title_at(
                                                        downloadRow.index)
