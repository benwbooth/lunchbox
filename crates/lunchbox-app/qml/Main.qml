                                    font.pixelSize: 13
                                    font.weight: Font.DemiBold
                                    elide: Text.ElideRight
                                }
                                Text {
                                    Layout.fillWidth: true
                                    text: gameDetails.session_emulator_at(
                                              sessionHistoryRow.sourceIndex)
