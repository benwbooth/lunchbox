                        width: parent.width
                        topPadding: 6
                        text: "TITLE CANDIDATES — REVIEW REQUIRED"
                        color: root.accent
                        font.pixelSize: 10
                        font.weight: Font.Bold
                        font.letterSpacing: 0.8
                    }
                    Repeater {
                        model: gameDetails.file_count
