                        MetadataField {
                            Layout.fillWidth: true
                            Layout.leftMargin: 24
                            label: "Play mode"
                            value: gameDetails.metadata_play_mode
                            placeholder: "Single player, multiplayer…"
                            onEdited: function(value) { gameDetails.metadata_play_mode = value }
