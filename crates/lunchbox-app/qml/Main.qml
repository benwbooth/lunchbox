                        MetadataField {
                            Layout.fillWidth: true
                            Layout.rightMargin: 24
                            label: "Release status"
                            value: gameDetails.metadata_release_status
                            placeholder: "Released, prototype…"
                            onEdited: function(value) { gameDetails.metadata_release_status = value }
