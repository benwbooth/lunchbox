    function rotateSelectedHeroArtwork(offset) {
        if (selectedHeroArtworkCount < 2)
            return
        selectedHeroArtworkIndex = (selectedHeroArtworkIndex + offset
                                    + selectedHeroArtworkCount)
                                   % selectedHeroArtworkCount
        refreshSelectedArtwork()
