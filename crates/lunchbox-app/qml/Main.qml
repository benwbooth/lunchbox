        if (status === "missing" || status === "unavailable")
            return "#ff7a88"
        if (status === "changed" || status === "unreadable")
            return root.accent
        if (status === "duplicate")
            return "#bb9cff"
        return "#69b7ff"
    }

    function mediaAuditStatusColor(status) {
        if (status === "repaired")
