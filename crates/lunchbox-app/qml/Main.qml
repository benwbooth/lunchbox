                                        font.weight: Font.DemiBold
                                        elide: Text.ElideRight
                                    }
                                    Text {
                                        text: { downloadRow.queueRevision; return downloadQueue.job_state_at(downloadRow.index) }
                                        color: text === "IMPORTED" ? root.accentCool
                                               : text === "FAILED" ? "#ff8b9a"
                                               : root.accent
                                        font.pixelSize: 9
                                        font.weight: Font.Bold
                                    }
