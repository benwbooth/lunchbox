                    model: activityHistoryDialog.filteredRows
                    ScrollBar.vertical: ScrollBar { policy: ScrollBar.AsNeeded }
                    delegate: Rectangle {
                        id: sessionHistoryRow
                        required property int modelData
                        readonly property int sourceIndex: modelData
