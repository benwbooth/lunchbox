                                    text: "Cancel"
                                    onClicked: appSettings.cancel_controller_profile_edit()
                                }
                                HeaderButton {
                                    text: "Save profile"
                                    active: true
                                    enabled: controllerProfileName.text.trim().length > 0
                                    onClicked: appSettings.save_controller_profile()
                                }
                            }
