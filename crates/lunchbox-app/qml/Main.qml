                        MetadataField {
                            Layout.fillWidth: true
                            Layout.rightMargin: 24
                            label: "Version"
                            value: gameDetails.metadata_version
                            placeholder: "Rev 1, v1.2…"
                            onEdited: function(value) { gameDetails.metadata_version = value }
