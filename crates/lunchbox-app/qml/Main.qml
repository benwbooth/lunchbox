            contentItem: Item {
            ColumnLayout {
                anchors.fill: parent
                anchors.margins: 20
                spacing: 10

                Rectangle {
                    Layout.fillWidth: true
                    Layout.preferredHeight: 66
                    radius: 9
                    color: "#121c29"
                    border.color: importProfile.currentIndex > 0 ? "#29556a" : root.line
                    RowLayout {
                        anchors.fill: parent
                        anchors.margins: 11
                        spacing: 9
                        Rectangle {
                            Layout.preferredWidth: 34
                            Layout.preferredHeight: 34
                            radius: 8
                            color: "#173042"
                            Text {
                                anchors.centerIn: parent
                                text: "↻"
                                color: root.accentCool
                                font.pixelSize: 17
                                font.weight: Font.Bold
                            }
                        }
                        ColumnLayout {
                            Layout.preferredWidth: 255
                            spacing: 3
                            Text {
                                text: "SCAN PROFILE"
                                color: root.muted
                                font.pixelSize: 8
                                font.weight: Font.Bold
                                font.letterSpacing: 0.8
                            }
                            ComboBox {
                                id: importProfile
                                Layout.fillWidth: true
                                enabled: !localImport.busy && !localImport.profile_busy
                                model: {
                                    const values = ["One-time scan"]
                                    const revision = localImport.profile_revision
                                    for (let index = 0; index < localImport.profile_count; ++index)
                                        values.push(localImport.profile_name_at(index))
                                    return values
                                }
                                onActivated: {
