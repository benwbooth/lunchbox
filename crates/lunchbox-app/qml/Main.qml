                    currentIndex: root.artworkIndex(emuMovies.artwork_type)
                    enabled: !emuMovies.busy
                    onActivated: emuMovies.choose_artwork_kind(currentValue)
                }
                HeaderButton {
                    text: emuMovies.busy ? "Downloading…"
