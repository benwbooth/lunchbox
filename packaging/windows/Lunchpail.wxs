<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Lunchpail"
    Manufacturer="Lunchpail"
    Version="$(Version)"
    UpgradeCode="A9F5844F-7D95-4B8A-AF19-31AC0B829B1A"
    Scope="perMachine">
    <SummaryInformation Description="Lunchpail game library and emulator frontend" />
    <MajorUpgrade DowngradeErrorMessage="A newer version of Lunchpail is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Lunchpail" />
    </StandardDirectory>

    <Files Include="$(StageDir)\**" Directory="INSTALLFOLDER">
      <Exclude Files="$(StageDir)\**\*.pdb" />
    </Files>
  </Package>
</Wix>
