@@ -424,1 +424,46 @@
+bool command_lunchbox_set_mouse_routes(command_t *cmd, const char *arg)
+{
+   unsigned routes[8], i, j;
+   bool disabled = true, identical = true;
+   const char *cursor = arg;
+   settings_t *settings = config_get_ptr();
+   input_driver_state_t *input_st = input_state_get_ptr();
+   if (!cursor || !input_st || !input_st->current_driver
+         || !string_is_equal(input_st->current_driver->ident, "udev")
+         || !settings->bools.stdin_cmd_enable
+         || settings->bools.network_cmd_enable)
+      return false;
+   for (i = 0; i < 8; ++i)
+   {
+      unsigned value = 0;
+      if (*cursor < '0' || *cursor > '9')
+         return false;
+      while (*cursor >= '0' && *cursor <= '9')
+      {
+         value = value * 10 + (unsigned)(*cursor++ - '0');
+         if (value > MAX_INPUT_DEVICES)
+            return false;
+      }
+      routes[i] = value;
+      if (i < 7)
+      {
+         if (*cursor++ != ' ')
+            return false;
+      }
+      else if (*cursor)
+         return false;
+      for (j = 0; j < i; ++j)
+         if (value < MAX_INPUT_DEVICES && routes[j] == value)
+            return false;
+      disabled = disabled && settings->uints.input_mouse_index[i] == MAX_INPUT_DEVICES;
+      identical = identical && settings->uints.input_mouse_index[i] == value;
+   }
+   /* Never silently replace an already active, different routing table. */
+   if (!disabled && !identical)
+      return false;
+   for (i = 0; i < 8; ++i)
+      settings->uints.input_mouse_index[i] = routes[i];
+   return command_get_config_param(cmd, "lunchbox_mouse_routes_v1");
+}
+
 bool command_get_config_param(command_t *cmd, const char* arg)
